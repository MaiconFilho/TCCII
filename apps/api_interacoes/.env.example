DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/TCC
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_HOST=127.0.0.1
API_PORT=8000
# Conexão separada de escrita, restrita à fila. Se omitida, usa DATABASE_URL.
# SOLICITACOES_DATABASE_URL=postgresql://usuario_fila:senha@localhost:5432/TCC
# Mesmo identificador usado pelo trabalhador na geração de vetores.
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-small
# Inclusão experimental suspensa; a consulta usa somente medicamentos cadastrados.
API_INCLUSAO_MEDICAMENTOS=false
# Só inicia o trabalhador quando a inclusão estiver habilitada.
API_WORKER_AUTOSTART=true
# Padrão local: Python da .venv de extracao_interacoes; alternativa: Python da API.
# API_WORKER_PYTHON=C:/caminho/ambiente-pipelines/Scripts/python.exe
# Opcional: conexão com permissões dos pipelines, na mesma base da API/fila.
# API_WORKER_DATABASE_URL=postgresql://usuario_pipelines:senha@localhost:5432/TCC

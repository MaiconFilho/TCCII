# Endereço da API de interações (api_interacoes). Copie para .env.local se
# precisar de outro endereço; sem este arquivo, vale http://127.0.0.1:8000.
# O valor é fixado no "npm run build": refaça o build se mudar.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Inclusão experimental suspensa. Reativação exige também habilitar a API e refazer o build.
NEXT_PUBLIC_INCLUSAO_MEDICAMENTOS=false

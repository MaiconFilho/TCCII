# Opcional: por padrão, reutiliza pipelines/identificacao_interacoes/.env.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/TCC
# Mesmo provedor e cache de modelos da identificação/extração.
IDENTIFICACAO_HF_MODEL_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
IDENTIFICACAO_HF_MODEL_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
# A CLI aplica --contexto 4096, --tokens-card 192 e --tokens-geral 320 (por parágrafo).
# Esses limites não alteram a configuração da extração/identificação.
IDENTIFICACAO_LLM_INFERENCE_CONCURRENCY=1
IDENTIFICACAO_LLM_TEMPERATURE=0

# Segunda etapa independente. Não altera o Qwen da etapa anterior.
REESCRITA_HF_MODEL_REPO=ggml-org/SmolLM3-3B-GGUF
REESCRITA_HF_MODEL_FILE=SmolLM3-Q4_K_M.gguf
REESCRITA_HF_MODEL_REVISION=4965cb60b150737b68a0408c36aeefb65078f894
REESCRITA_CONTEXTO=2048
REESCRITA_TOKENS_CARD=256
REESCRITA_TOKENS_GERAL=384
REESCRITA_THREADS=2
REESCRITA_LOTE=16
REESCRITA_TENTATIVAS=3
REESCRITA_TIMEOUT=180
REESCRITA_TIMEOUT_CARGA=600
REESCRITA_MEMORIA_MAX_MB=3584
REESCRITA_RAM_MINIMA_MB=1800

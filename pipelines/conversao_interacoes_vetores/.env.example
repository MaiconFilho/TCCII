DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/TCC

# Modelo de embeddings executado localmente em CPU (Transformers).
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_INPUT_TOKENS=512
EMBEDDING_NORMALIZE=true
EMBEDDING_CHUNK_SIZE=450
EMBEDDING_CHUNK_OVERLAP=60
EMBEDDING_THREADS=0
EMBEDDING_MAX_PROCESS_MEMORY_MB=5500
EMBEDDING_INFERENCE_CONCURRENCY=1

# Prefixo exigido pela familia E5 ao indexar passagens.
# Use uma string vazia para modelos que nao pedem prefixo.
EMBEDDING_PASSAGE_PREFIX=passage: 

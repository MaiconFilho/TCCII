DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/TCC

# Mesmo GGUF da extração; o cache padrão é pipelines/extracao_interacoes/modelos_hf,
# então nada é baixado de novo quando a extração já foi executada.
IDENTIFICACAO_HF_MODEL_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
IDENTIFICACAO_HF_MODEL_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
# IDENTIFICACAO_MODELOS_DIR=C:/caminho/modelos_hf

# Limites próprios desta etapa (não herdam os 256 tokens da extração).
IDENTIFICACAO_LLM_CONTEXT_SIZE=8192
IDENTIFICACAO_LLM_MAX_OUTPUT_TOKENS=3072
IDENTIFICACAO_JANELA_TOKENS=1000
IDENTIFICACAO_JANELA_SOBREPOSICAO=150
IDENTIFICACAO_LLM_THREADS=0
IDENTIFICACAO_LLM_BATCH_SIZE=256
IDENTIFICACAO_LLM_GPU_LAYERS=0
IDENTIFICACAO_LLM_TEMPERATURE=0
IDENTIFICACAO_LLM_MAX_PROCESS_MEMORY_MB=5500
IDENTIFICACAO_LLM_INFERENCE_CONCURRENCY=1

# Rodadas de correção para alvos rejeitados pela validação (0 desliga).
IDENTIFICACAO_TENTATIVAS_CORRECAO=1
# Quantas vezes uma janela pode ser dividida ao atingir limites.
IDENTIFICACAO_MAX_DIVISOES_JANELA=4
IDENTIFICACAO_MAX_CARACTERES_RESUMO=300
# Pergunta ao modelo os integrantes citados quando aceita uma classe.
IDENTIFICACAO_EXEMPLOS_DE_CLASSE=true
# Relê sozinha, com o modelo, uma frase-lista longa que voltou sem alvos.
IDENTIFICACAO_RELEITURA_LISTAS=true

# dicionario (padrão): nomes do banco citados no tópico, sem modelo; a base
# inteira roda em cerca de 1 minuto. atual e duas_etapas usam a LLM local
# (as configurações acima só valem para elas).
IDENTIFICACAO_ESTRATEGIA=dicionario
# Usado somente na estratégia duas_etapas; limite de 1 a 12 relações por lote.
IDENTIFICACAO_LOTE_RESUMOS=6

# Somente para os testes de integração: banco isolado, nunca o TCC.
# IDENTIFICACAO_TEST_DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/tcc_identificacao_testes

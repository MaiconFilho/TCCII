# Mesma base da API; este usuário precisa ler e gravar os pipelines e a fila.
WORKER_DATABASE_URL=postgresql://usuario:senha@localhost:5432/TCC
# Sessão normal do Chrome; o modo sem janela foi recusado nos pilotos.
WORKER_HEADLESS=false
WORKER_INTERVALO_SEGUNDOS=5
WORKER_MAX_TENTATIVAS=3
WORKER_ETAPA_TIMEOUT_SEGUNDOS=3600
# Omitir para usar as pastas padrão do módulo e do scraper.
# WORKER_PDFS_DIR=C:/dados/interamed/pdfs
# Padrão: pipelines/scraping_anvisa/.chrome-profile-anvisa (perfil do scraper original).
# WORKER_CHROME_PROFILE=C:/dados/interamed/.chrome-profile-anvisa
# Omitir para executar cada etapa com o mesmo Python do trabalhador.
# WORKER_PYTHON_EXTRACAO=C:/projeto/pipelines/extracao_interacoes/.venv/Scripts/python.exe
# WORKER_PYTHON_IDENTIFICACAO=C:/projeto/pipelines/extracao_interacoes/.venv/Scripts/python.exe
# WORKER_PYTHON_VINCULOS=C:/projeto/pipelines/extracao_interacoes/.venv/Scripts/python.exe
# WORKER_PYTHON_VETORES=C:/projeto/pipelines/extracao_interacoes/.venv/Scripts/python.exe
# WORKER_PYTHON_RESUMOS=C:/projeto/pipelines/extracao_interacoes/.venv/Scripts/python.exe
# Deve coincidir com o modelo de vetores informado à API.
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-small
# As configurações dos modelos continuam nos .env das etapas existentes.

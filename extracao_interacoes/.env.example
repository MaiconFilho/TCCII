DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/TCC

LLM_BACKEND=llama_cpp

# OCR local e seletivo por pagina (python preparar_ocr.py).
OCR_HABILITADO=true
OCR_IDIOMA=por
OCR_DPI=200
# OCR_TESSDATA=C:/caminho/tessdata
EXTRACAO_MODO=rapido
HF_MODEL_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
HF_MODEL_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
LLM_CONTEXT_SIZE=4096
LLM_CHUNK_TOKENS=700
LLM_CHUNK_OVERLAP=100
LLM_MAX_OUTPUT_TOKENS=256
LLM_THREADS=0
LLM_BATCH_SIZE=128
LLM_GPU_LAYERS=0
LLM_TEMPERATURE=0
LLM_MAX_PROCESS_MEMORY_MB=5500
LLM_INFERENCE_CONCURRENCY=1
